<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ts_background"
    android:padding="16dp">

    <TextView
        android:id="@+id/btnMemoryBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Back"
        android:textColor="@color/ts_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Memory Card Game 🧠"
        android:textColor="@color/ts_text"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Find two matching animal cards!"
        android:textColor="@color/ts_text"
        android:textSize="14sp"
        android:gravity="center"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMoves"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 Moves: 0"
            android:textColor="@color/ts_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginEnd="24dp"/>

        <TextView
            android:id="@+id/tvPairs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ Pairs: 0/4"
            android:textColor="@color/ts_text"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <GridLayout
        android:id="@+id/memoryGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:columnCount="4"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="false"/>

    <TextView
        android:id="@+id/tvMemoryFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Find the matching animal pairs! 🐾"
        android:textColor="@color/ts_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <Button
        android:id="@+id/btnMemoryAgain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Play Again 🔄"
        android:visibility="gone"
        android:backgroundTint="@color/ts_primary"
        android:textColor="@color/white"/>

</LinearLayout>
