<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ts_background"
    android:padding="16dp">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Back"
        android:textColor="@color/ts_text"
        android:backgroundTint="@color/ts_secondary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Let's Learn Food! 🍎"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/ts_text"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnFruits"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🍎 Fruits"
            android:backgroundTint="@color/ts_secondary"
            android:textColor="@color/ts_text"
            android:layout_marginEnd="5dp" />

        <Button
            android:id="@+id/btnVegetables"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🥕 Vegetables"
            android:backgroundTint="@color/ts_yellow"
            android:textColor="@color/ts_text"
            android:layout_marginStart="5dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card_white"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvSelectedFood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍎"
            android:textSize="60sp" />

        <TextView
            android:id="@+id/tvEnglishName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apple"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="@color/ts_text"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvBanglaName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="আপেল"
            android:textSize="21sp"
            android:textColor="@color/ts_text"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnSpeak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔊 Listen"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/ts_primary" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose an Item"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/ts_text"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <GridLayout
            android:id="@+id/foodGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2" />

    </ScrollView>

</LinearLayout>
