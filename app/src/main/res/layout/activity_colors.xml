<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ts_background"
    android:padding="16dp">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Back"
        android:textColor="@color/ts_text"
        android:backgroundTint="@color/ts_secondary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Let's Learn Colors! 🎨"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/ts_text"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card_white"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvSelectedColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textSize="76sp"
            android:textColor="#F44336" />

        <TextView
            android:id="@+id/tvEnglishName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Red"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/ts_text"
            android:layout_marginTop="5dp" />

        <TextView
            android:id="@+id/tvBanglaName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="লাল"
            android:textSize="22sp"
            android:textColor="@color/ts_text"
            android:layout_marginTop="5dp" />

        <Button
            android:id="@+id/btnSpeak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔊 Listen"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/ts_primary" />

    </LinearLayout>

    <Button
        android:id="@+id/btnShapes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Explore Shapes ⭐"
        android:textColor="@color/white"
        android:backgroundTint="@color/ts_primary"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose a Color"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/ts_text"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <GridLayout
            android:id="@+id/colorGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2" />

    </ScrollView>

</LinearLayout>
